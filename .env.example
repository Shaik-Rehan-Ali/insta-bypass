# Proxy Configuration (for Vercel deployment)
# Set PROXY_ENABLED=true to use proxy API for Instagram requests
# This bypasses Instagram's datacenter IP blocking

# Enable proxy (true/false)
PROXY_ENABLED=false

# Proxy API URL (default: ScrapeOps)
PROXY_API_URL=https://proxy.scrapeops.io/v1/

# Proxy API Key - Get free key from: https://scrapeops.io
# Free tier: 1000 requests/month
PROXY_API_KEY=your_api_key_here

# For localhost: Keep PROXY_ENABLED=false (direct requests work)
# For Vercel: Set PROXY_ENABLED=true and add your API key to Vercel env vars
